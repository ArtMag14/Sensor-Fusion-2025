        sys.exit(1)
    
    # Use the first found port
    port_to_use = possible_ports[0]
    print(f"🔍 Found ESP32 on {port_to_use}")
    
    # Choose which brain to run:
    
    # Option 1: Basic brain (starts here)
    brain = RobotBrain(port=port_to_use)
    brain.run()
    
