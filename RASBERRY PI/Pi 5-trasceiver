    possible_ports = glob.glob('/dev/ttyUSB*') + glob.glob('/dev/ttyACM*')
    
    if not possible_ports:
        print("❌ No ESP32-S3 found!")
        print("💡 Make sure your ESP32-S3 is connected via USB")
